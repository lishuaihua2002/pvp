# Supabase 项目配置（在 Supabase Dashboard -> Project Settings -> API 获取）
# 只能使用 Project URL 和 Publishable/Anon Key，绝对不要把 service_role / Secret Key 放进前端！
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# 黑客松演示模式：true 时登录页突出游客入口
VITE_DEMO_MODE=true
